{{!-- Mob's Abilities tab ("Building a Mob", p.270-272) - a stat-block-shaped
      layout (Surprise/Evade/Move/DR reference row, an editable Stat block,
      a structured Attacks list) instead of the PC-shaped abilities.hbs
      (banked stat points, class/race-driven bonuses). Skills/Spells stay
      available below for the rare Mob that needs a real itemized Skill,
      via the same partials/markup abilities.hbs uses. --}}
<section class="tab scrollable {{tab.cssClass}}" data-group="primary" data-tab="abilities">
  <div class="carl-abilities-layout">
    {{> "systems/carl-rpg/templates/actor/parts/stats-column.hbs"}}

    <div class="carl-abilities-main">
      <div class="carl-mob-statblock-row">
        <div class="carl-mob-statblock-field">
          <label class="resource-label">{{localize "CARLRPG.Roll.Surprise"}}</label>
          <span class="carl-stat-value" title="{{localize 'CARLRPG.Actor.SurpriseHint'}}">{{system.surpriseBase}}+F</span>
          {{#if system.surpriseDebuffDelta}}<i class="fas fa-skull-crossbones carl-debuffed-marker" title="{{localize 'CARLRPG.Actor.DebuffedValueHint'}} ({{system.surpriseDebuffDelta}})"></i>{{/if}}
        </div>
        <div class="carl-mob-statblock-field">
          <label class="resource-label">{{localize "CARLRPG.Roll.Evade"}}</label>
          <span class="carl-stat-value" title="{{localize 'CARLRPG.Actor.EvadeHint'}}">{{system.evadeBase}}+F</span>
          {{#if system.evadeDebuffDelta}}<i class="fas fa-skull-crossbones carl-debuffed-marker" title="{{localize 'CARLRPG.Actor.DebuffedValueHint'}} ({{system.evadeDebuffDelta}})"></i>{{/if}}
        </div>
        <div class="carl-mob-statblock-field">
          <label for="system.move" class="resource-label">{{localize "CARLRPG.Actor.Move"}}</label>
          <input type="text" class="carl-w-tiny" name="system.move" value="{{system.move}}" placeholder="20+S" />
        </div>
        <div class="carl-mob-statblock-field">
          <label class="resource-label">{{localize "CARLRPG.Actor.Dr"}}</label>
          {{!-- Read-only here, not a second `name="system.dr"` input: this
                part (abilities-mob.hbs) and description.hbs both render into
                the same <form> at once (every tab's content is rendered
                simultaneously, only CSS toggles which is visible), so two
                same-named fields become a RadioNodeList - Foundry's
                FormDataExtended then submits system.dr as a 2-element ARRAY
                on ANY sheet edit (not just to this field), which the schema
                rejects with "dr: must be a number". Description.hbs's own
                Defenses fieldset is the sole editable copy. --}}
          <span class="carl-stat-value" title="{{localize 'CARLRPG.Actor.DrEditHint'}}">{{system.dr}}{{#if system.drBonus}} (={{system.drEffective}}){{/if}}</span>
        </div>
      </div>

      {{#> carlCollapsibleSection sectionId="attacks" expanded=system.uiState.attacksExpanded
           label=(localize "CARLRPG.Tab.Attacks") toggleScope="actor" togglePath="system.uiState.attacksExpanded"}}
        {{> "systems/carl-rpg/templates/actor/parts/attacks-list.hbs"}}
      {{/carlCollapsibleSection}}

      {{#> carlCollapsibleSection sectionId="skills" expanded=system.uiState.skillsExpanded
           label=(localize "CARLRPG.Tab.Skills") toggleScope="actor" togglePath="system.uiState.skillsExpanded"
           showLockToggle=true locked=system.uiState.itemsLocked}}
        {{> "systems/carl-rpg/templates/actor/parts/skills-section-body.hbs"
            skills=skills unmatchedDamageEffects=unmatchedDamageEffects config=config locked=system.uiState.itemsLocked}}
      {{/carlCollapsibleSection}}

      {{#> carlCollapsibleSection sectionId="spells" expanded=system.uiState.spellsExpanded
           label=(localize "CARLRPG.Tab.Spells") toggleScope="actor" togglePath="system.uiState.spellsExpanded"
           showMana=true manaValue=system.mana.value manaMax=system.mana.max}}
        {{> "systems/carl-rpg/templates/actor/parts/spells-section-body.hbs" spells=spells locked=system.uiState.itemsLocked}}
      {{/carlCollapsibleSection}}
    </div>
  </div>
</section>
